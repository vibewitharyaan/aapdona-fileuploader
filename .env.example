# Copy to .env and set a strong password. Uploads 401 without it.
UPLOAD_PASSWORD=change-me

# Optional overrides (defaults shown)
# MAX_SIZE=4294967296
# STORAGE_CAP=4294967296
# ONCE_TTL=259200
# SOCK_TIMEOUT=300
# MAX_THREADS=32
# UPLOAD_HOST=127.0.0.1
# UPLOAD_PORT=8000
# UPLOAD_DIR=./uploads
# ZIP_SCAN_LIMIT=67108864
# ASSUMED_BANDWIDTH=20971520
